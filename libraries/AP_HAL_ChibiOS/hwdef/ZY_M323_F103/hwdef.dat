# ZY M323 GPS — STM32F103CBT6 AP_Periph
# Pinout matches F303-compatible M323 layout (LED on PA4)
# Sensors: u-blox GPS, TE MS5611 baro, QMC/HMC 5883 compass

# MCU class and specific type
MCU STM32F103 STM32F103xB

FLASH_RESERVE_START_KB 25
STORAGE_FLASH_PAGE 23
define HAL_STORAGE_SIZE 800

APJ_BOARD_ID AP_HW_F103_PERIPH
env AP_PERIPH 1

OSCILLATOR_HZ 8000000
define CH_CFG_ST_FREQUENCY 1000
FLASH_SIZE_KB 128

SERIAL_ORDER EMPTY EMPTY EMPTY USART1

# CAN status LED — PA4 (same as F303 / ZY M323)
PA4 LED OUTPUT LOW
define HAL_LED_ON 1

PA9  USART1_TX USART1 SPEED_HIGH NODMA
PA10 USART1_RX USART1 SPEED_HIGH NODMA

define HAL_UART_NODMA

PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
PB0 MAG_CS CS

define HAL_USE_ADC TRUE
define STM32_ADC_USE_ADC1 TRUE
define HAL_DISABLE_ADC_DRIVER TRUE

define CH_CFG_ST_TIMEDELTA 0
define SERIAL_BUFFERS_SIZE 512
define PORT_INT_REQUIRED_STACK 64
define HAL_NO_TIMER_THREAD
define HAL_NO_RCOUT_THREAD
define __FPU_PRESENT 0
define DMA_RESERVE_SIZE 0

MAIN_STACK 0x200
PROCESS_STACK 0xA00

PA11 CAN_RX CAN
PA12 CAN_TX CAN

define HAL_CAN_POOL_SIZE 2500
define HAL_USE_I2C TRUE
define STM32_I2C_USE_I2C1 TRUE

define HAL_UART_MIN_TX_SIZE 128
define HAL_UART_MIN_RX_SIZE 128
define HAL_UART_STACK_SIZE 256
define STORAGE_THD_WA_SIZE 300
define IO_THD_WA_SIZE      300

I2C_ORDER I2C1
define HAL_I2C_CLEAR_ON_TIMEOUT 0
define HAL_DEVICE_THREAD_STACK 256
define HAL_I2C_INTERNAL_MASK 0

define GPS_MAX_RECEIVERS 1
define GPS_MAX_INSTANCES 1
define HAL_COMPASS_MAX_SENSORS 1
define HAL_GYROFFT_ENABLED 0

env ROMFS_UNCOMPRESSED True
define HAL_CAN_RX_QUEUE_SIZE 32
define CH_DBG_ENABLE_STACK_CHECK FALSE

define CAN_APP_NODE_NAME "org.ardupilot.ZY_M323_F103"
define HAL_CAN_BAUDRATE_DEFAULT 500000
define HAL_CAN_DEFAULT_NODE_ID 30
define HAL_PERIPH_PRINTF_TO_CAN 1

# no embedded bootloader (flash BL via SWD once)
define AP_BOOTLOADER_FLASHING_ENABLED 0
undef ROMFS
define HAL_NO_ROMFS_SUPPORT

# single baro — hide BARO2/BARO3 params; sensors are fixed in hwdef
define BARO_MAX_INSTANCES 1
define AP_BARO_PROBE_EXTERNAL_I2C_BUSES 0

# hide rarely-used GPS advanced params (use compiled-in defaults)
define AP_GPS_ADVANCED_CONFIG_ENABLED 0

# TE MS5611 on I2C (CSB -> 0x77 or 0x76)
define AP_BARO_BACKEND_DEFAULT_ENABLED 0
define AP_BARO_MS5611_ENABLED 1
define AP_BARO_MS5607_ENABLED 0
BARO MS5611 I2C:0:0x77
BARO MS5611 I2C:0:0x76

# Mag: QMC5883 @ 0x0D (often labeled HA5883); also HMC @ 0x1E
define AP_COMPASS_BACKEND_DEFAULT_ENABLED 0
define AP_COMPASS_QMC5883L_ENABLED 1
define AP_COMPASS_HMC5843_ENABLED 1
COMPASS QMC5883L I2C:0:0x0D false ROTATION_NONE
COMPASS HMC5843 I2C:0:0x1E false ROTATION_NONE

undef HAL_UART_MIN_TX_SIZE
define HAL_UART_MIN_TX_SIZE 256

define AP_PERIPH_GPS_ENABLED 1
define AP_PERIPH_MAG_ENABLED 1
define AP_PERIPH_BARO_ENABLED 1

define AP_GPS_BACKEND_DEFAULT_ENABLED 0
define AP_GPS_UBLOX_ENABLED 1
define AP_GPS_NOVA_ENABLED 0
define AP_GPS_SBF_ENABLED 0
define AP_GPS_GSOF_ENABLED 0
define AP_GPS_NMEA_ENABLED 0
define AP_GPS_SIRF_ENABLED 0
define AP_GPS_ERB_ENABLED 0
define AP_GPS_SBP_ENABLED 0
define AP_GPS_SBP2_ENABLED 0
define AP_GPS_MAV_ENABLED 0
define AP_GPS_DRONECAN_ENABLED 0
