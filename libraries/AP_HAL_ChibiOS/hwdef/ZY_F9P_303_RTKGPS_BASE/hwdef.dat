# ZY F9P RTK GPS — Moving Baseline BASE (GPS_TYPE=17)
# Flash this on the Base-antenna F303 node.

include ../ZY_F9P_303_RTKGPS/hwdef.inc

define CAN_APP_NODE_NAME "org.ardupilot.ZY_F9P_Base"
define HAL_CAN_DEFAULT_NODE_ID 40

# uBlox Moving Baseline Base
define HAL_GPS1_TYPE_DEFAULT 17
# GPS+Galileo+BeiDou+GLONASS. Do not add QZSS (that would be 109).
define HAL_GPS1_GNSS_MODE_DEFAULT 77
# AP_Periph.cpp uses this in #if; 0 keeps the F9P debug prints out.
define AP_PERIPH_GPS_DEBUG_ENABLED 0
