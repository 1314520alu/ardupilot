# temperature control. We need lower P/I values
# to prevent oscillation of the BMI088 temperature
# the ADIS16470 is factory temperature calibrated,
# but the BMI088 isn't, so temperature control is still
# worthwhile
BRD_HEAT_TARG 45
BRD_HEAT_P 50
BRD_HEAT_I 0.07

# CAN1 stays on driver 1 (DroneCAN). CAN2 is off until the user opts in.
# eRob CAN is protocol 15 and owns a separate driver on CAN2:
#   CAN_P1_DRIVER 1
#   CAN_D1_PROTOCOL 1
#   CAN_P2_DRIVER 2
#   CAN_D2_PROTOCOL 15
#   CAN_P2_BITRATE 1000000
#   CAN_D2_EROB_SV1 1
#   CAN_D2_EROB_ID1 1
# Do not put protocol 15 on CAN1. USB HS shares the CAN2 pins; this
# hwdef keeps USB on FS so CAN2 can run.
# turn on the CAN power monitoring(default)
CAN_P1_DRIVER 1
BATT_MONITOR 8

# setup the parameter for the ADC power module
BATT_VOLT_PIN 16
BATT_CURR_PIN 17
BATT_VOLT_MULT 18.000
BATT_AMP_PERVLT 24.000
