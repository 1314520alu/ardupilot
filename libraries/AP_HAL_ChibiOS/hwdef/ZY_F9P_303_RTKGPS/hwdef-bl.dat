# ZY F9P RTK GPS — STM32F303CBT6 bootloader (128KB flash)

include ../f303-periph/hwdef-bl.inc

define HAL_CAN_BAUDRATE_DEFAULT 500000

undef FLASH_SIZE_KB
FLASH_SIZE_KB 128

# Match app layout: 20KB bootloader, params at end
undef FLASH_BOOTLOADER_LOAD_KB
FLASH_BOOTLOADER_LOAD_KB 20
undef APP_START_OFFSET_KB
APP_START_OFFSET_KB 0
undef STORAGE_FLASH_PAGE
STORAGE_FLASH_PAGE 62

APJ_BOARD_ID AP_HW_ZY_F9P_303_RTKGPS
