include ../MatekL431/hwdef.inc
define HAL_USE_ADC FALSE
define STM32_ADC_USE_ADC1 FALSE
define HAL_DISABLE_ADC_DRIVER TRUE

# 强制启用 HARDPOINT 支持（虽然默认已支持，但显式加保险）
define AP_PERIPH_HARDPOINT_ENABLED 1

# 重定义原 5 个 PWM 引脚为 HARDPOINT（全部改用）
PA8  LED1 OUTPUT LOW GPIO(50)
PA9  LED2 OUTPUT LOW GPIO(51)
PA10 LED3 OUTPUT LOW GPIO(52)
PA11 LED4 OUTPUT LOW GPIO(53)
PA12 LED5 OUTPUT LOW GPIO(54)
PA15 LED6 OUTPUT LOW GPIO(55)

define DEBUG_HARDPOINT 1
define AP_PERIPH_RELAY_ENABLED TRUE
define AP_RELAY_ENABLED TRUE

define HAL_USE_USB FALSE
define HAL_USB_ENABLED 0
define STM32_USB_USE_OTG1 FALSE