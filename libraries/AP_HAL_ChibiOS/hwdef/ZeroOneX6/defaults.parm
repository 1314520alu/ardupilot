# Both ports stay on driver 1 (DroneCAN) until the user opts in.
# eRob CANopen on CAN2; other 11-bit IDs on that port are classic CAN:
#   CAN_P1_DRIVER 1
#   CAN_D1_PROTOCOL 1
#   CAN_P2_DRIVER 2
#   CAN_D2_PROTOCOL 15
#   CAN_P2_BITRATE 1000000
#   CAN_D2_EROB_NODE 1
CAN_P1_DRIVER 1
CAN_P2_DRIVER 1

BATT_MONITOR 8
