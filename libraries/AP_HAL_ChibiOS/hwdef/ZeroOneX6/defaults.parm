# Both ports stay on driver 1 (DroneCAN) until the user opts in.
# One protocol per driver. eRob CAN on CAN2 replaces DroneCAN on that port:
#   CAN_P1_DRIVER 1
#   CAN_D1_PROTOCOL 1
#   CAN_P2_DRIVER 2
#   CAN_D2_PROTOCOL 15
#   CAN_P2_BITRATE 1000000
#   CAN_D2_EROB_NODE 1
#   CAN_D2_EROB_BM 1008
#   CAN_D2_EROB_MIN 0
#   CAN_D2_EROB_MAX 524288
# BM matches CAN_Dx_UC_SRV_BM. 1008 is SERVO5..SERVO10 (bits 4..9).
CAN_P1_DRIVER 1
CAN_P2_DRIVER 1

BATT_MONITOR 8
