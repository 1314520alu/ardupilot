# ZeroOne X6 first boot and parameter reset.
# A firmware flash does not replace values already stored in EEPROM.
# CAN1 stays DroneCAN. CAN2 is eRob CAN on its own driver.
# BRD_SAFETY_DEFLT 0 starts unlocked. A fitted switch still works after boot.
CAN_P1_DRIVER 1
CAN_D1_PROTOCOL 1
CAN_P2_DRIVER 2
CAN_D2_PROTOCOL 15
CAN_D2_PROTOCOL2 0
CAN_P2_BITRATE 1000000
CAN_D2_EROB_NODE 1
CAN_D2_EROB_BM 0
CAN_D2_EROB_SV1 1
CAN_D2_EROB_ID1 1
CAN_D2_EROB_SV2 2
CAN_D2_EROB_ID2 2
CAN_D2_EROB_SV3 3
CAN_D2_EROB_ID3 3
CAN_D2_EROB_SV4 4
CAN_D2_EROB_ID4 4
CAN_D2_EROB_SV5 0
CAN_D2_EROB_ID5 0
CAN_D2_EROB_SV6 0
CAN_D2_EROB_ID6 0
CAN_D2_EROB_SV7 0
CAN_D2_EROB_ID7 0
CAN_D2_EROB_SV8 0
CAN_D2_EROB_ID8 0
CAN_D2_EROB_RES 524288
CAN_D2_EROB_GEAR 0
CAN_D2_EROB_CTR 262144
CAN_D2_EROB_MIN -43691
CAN_D2_EROB_MAX 43691
CAN_D2_EROB_RATE 100
CAN_D2_EROB_ACC 500
CAN_D2_EROB_DEC 500
CAN_D2_EROB_FAR 0
BRD_SAFETY_DEFLT 0

BATT_MONITOR 8
