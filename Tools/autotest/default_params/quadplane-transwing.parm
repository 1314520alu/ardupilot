Q_ENABLE         1
Q_FRAME_CLASS    1
Q_FRAME_TYPE     1

# Use ArduPlane native continuous tiltrotor control. SERVO11 is the shared
# fold/tilt actuator observed by the Transwing SITL physics model.
Q_TILT_ENABLE    1
Q_TILT_TYPE      0
Q_TILT_MASK      15
Q_TILT_MAX       45
Q_TILT_RATE_UP   4.5
Q_TILT_RATE_DN   4.5

SCR_ENABLE       1

SERVO1_FUNCTION  33
SERVO2_FUNCTION  34
SERVO3_FUNCTION  35
SERVO4_FUNCTION  36
SERVO5_FUNCTION  4
SERVO6_FUNCTION  4
SERVO7_FUNCTION  19
SERVO8_FUNCTION  19
SERVO9_FUNCTION  21
SERVO10_FUNCTION 21
SERVO11_FUNCTION 41
SERVO11_MIN      1000
SERVO11_TRIM     1000
SERVO11_MAX      2000

Q_M_PWM_MIN      1000
Q_M_PWM_MAX      2000
Q_M_SPIN_ARM     0.08
