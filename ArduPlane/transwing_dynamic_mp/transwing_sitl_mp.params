# Transwing Mission Planner visual SITL parameters.
# Lua motor mix via AP Motors_dynamic (Q_FRAME_CLASS=17). Requires SCR_ENABLE=1.
# Airspeed: blend=13, FW min=19, cruise=25 (TRIM_ARSP_CM), max=31, Q_ASSIST=16 (19-3).

SCR_ENABLE,1

Q_ENABLE,1
Q_FRAME_CLASS,17
Q_FRAME_TYPE,1

SERVO13_FUNCTION,94
SERVO14_FUNCTION,95
SERVO15_FUNCTION,96
SERVO16_FUNCTION,97

Q_TRANSITION_MS,25000
# Q_TILT_MAX: AP native tilt ceiling. Empirically fold theta ≈ 90 - Q_TILT_MAX
# (Q_TILT_MAX=30 caps at ~60deg/1333 PWM). Use 90; Lua holds at 55/30 deg.
Q_TILT_MAX,90
AIRSPEED_MIN,19
ARSPD_FBW_MIN,19
Q_ASSIST_SPEED,16
TRIM_ARSP_CM,2500
AIRSPEED_MAX,31
ROLL_LIMIT_DEG,40
RC_OVERRIDE_TIME,10

TW_ENABLE,1
TW_LOG_ONLY,0
TW_MIX_MODE,2
TW_INPUT_SRC,1
TW_PWM_FW,2000
TW_PWM_Q,1000
TW_RATE_UP,4.5
TW_RATE_DN,4.5
TW_GUARD,1
TW_GUARD_FBWA,1
TW_GUARD_MS,1000
TW_SAFE_MIN,55
TW_BLEND_AS,13
TW_FW_AS,19
TW_ATT_DANG,55
TW_DESC_DANG,-8
TW_SAT_PWM,1980
TW_ACCEL_MIN,55
TW_BLEND_MIN,30
TW_ATT_ABORT,42
TW_ASST_EN,1
TW_MIX_BLEND,0
